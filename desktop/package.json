{
  "name": "arsenal",
  "productName": "Arsenal",
  "version": "1.1.0",
  "private": true,
  "description": "Arsenal \u2014 Desarrollado por Francisco J Vazquez Santiago",
  "author": "Francisco J Vazquez Santiago",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:apps": "python ../scripts/prepare_apps.py && node scripts/copy-apps.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "test:smoke": "node tests/smoke.mjs",
    "package:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "vite": "8.3.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "com.franciscojvazquez.omnidesk",
    "productName": "Arsenal",
    "copyright": "Desarrollado por Francisco J Vazquez Santiago",
    "directories": {
      "output": "release",
      "buildResources": "public/icons"
    },
    "files": [
      "dist/**/*",
      "!dist/tools/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist/tools",
        "to": "tools"
      }
    ],
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/arsenal.ico",
      "artifactName": "Arsenal-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arsenal",
      "installerIcon": "public/icons/arsenal.ico",
      "uninstallerIcon": "public/icons/arsenal.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "3082",
      "displayLanguageSelector": true,
      "include": "installer/options.nsh"
    }
  }
}
